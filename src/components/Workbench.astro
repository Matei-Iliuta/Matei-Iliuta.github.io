---
// Electronic parts arranged like a bouquet next to a breadboard: boards in the back row,
// small parts tucked in front of them. Hover (or a tap) lifts a part. Once on screen the spare
// parts fly off the page and the rest gather on a breadboard as a working parking sensor:
// an HC-SR04 measures the distance to your cursor (or finger), an OLED shows it, four LEDs fill
// up like a bar as it gets closer and the buzzer beeps faster. The potentiometer
// sets the alarm distance and the button mutes the buzzer.
type Item = { id: string; w: number; h: number; n?: number; spare?: boolean };
const back: Item[] = [
  { id: 'jumpers', w: 56, h: 72, spare: true },
  { id: 'bat', w: 34, h: 56, spare: true },
  { id: 'nano', w: 34, h: 80, spare: true },
  { id: 'oled', w: 46, h: 48 },
  { id: 'servo', w: 62, h: 34, spare: true },
  { id: 'esp', w: 46, h: 88, spare: true },
  { id: 'uno', w: 124, h: 88 },
  { id: 'lcd', w: 92, h: 38, spare: true },
  { id: 'sonar', w: 68, h: 38 },
  { id: 'relay', w: 46, h: 34, spare: true },
  { id: 'pico', w: 36, h: 74, spare: true },
  { id: 'motor', w: 40, h: 40, spare: true },
];
const front: Item[] = [
  { id: 'jumpers', w: 56, h: 72, n: 1, spare: true },
  { id: 'res', w: 54, h: 14, n: 0 },
  { id: 'diode', w: 50, h: 12, spare: true },
  { id: 'led', w: 22, h: 50, n: 0 },
  { id: 'npn', w: 20, h: 32, spare: true },
  { id: 'res', w: 54, h: 14, n: 1 },
  { id: 'cap', w: 22, h: 38, spare: true },
  { id: 'led', w: 22, h: 50, n: 1 },
  { id: 'cap', w: 22, h: 38 },
  { id: 'ic', w: 42, h: 24, spare: true },
  { id: 'btn', w: 30, h: 30 },
  { id: 'led', w: 22, h: 50, spare: true },
  { id: 'pot', w: 34, h: 40 },
  { id: 'buz', w: 32, h: 36 },
  { id: 'res', w: 54, h: 14, spare: true },
  { id: 'led', w: 22, h: 50, n: 2 },
  { id: 'res', w: 54, h: 14, n: 2 },
  { id: 'seg', w: 30, h: 42, spare: true },
  { id: 'npn', w: 20, h: 32, spare: true },
  { id: 'pull', w: 54, h: 14 },
  { id: 'led', w: 22, h: 50, n: 3 },
  { id: 'diode', w: 50, h: 12, spare: true },
  { id: 'res', w: 54, h: 14, n: 3 },
];
const all = [...back.map((p) => ({ ...p, layer: 'back' })), ...front.map((p) => ({ ...p, layer: 'front' }))];
---

<div class="wb">
<div class="stage" data-stage>
  <div class="rig">
    <div class="arc-space" data-arc aria-hidden="true"></div>
    <div class="bench" data-bench aria-hidden="true">
      <svg class="board" data-board></svg>
      <svg class="wires" data-wires></svg>
    </div>
  </div>
  <svg class="pings" data-pings aria-hidden="true">
    <g data-ping-group>
      <path class="ping" d="M14 -16 A 22 22 0 0 1 14 16"></path>
      <path class="ping" d="M14 -16 A 22 22 0 0 1 14 16"></path>
      <path class="ping" d="M14 -16 A 22 22 0 0 1 14 16"></path>
    </g>
  </svg>

  {
    all.map((p, i) => (
      <div
        class={`part part--${p.id} part--${p.layer}${p.spare ? ' part--spare' : ''}`}
        data-part={p.id}
        data-spare={p.spare ? '1' : ''}
        data-n={p.n ?? ''}
        data-w={p.w}
        data-h={p.h}
        style={`width:${p.w}px;height:${p.h}px;--i:${i}`}
        aria-hidden="true"
      >
        <div class="lift">
          {p.id === 'uno' && (
            <svg viewBox="0 0 124 88">
              <rect x="1" y="1" width="122" height="86" rx="6" fill="#1d1d1f" />
              <rect x="-2" y="10" width="22" height="20" rx="2" fill="#cfc8ba" />
              <rect x="-2" y="58" width="16" height="18" rx="3" fill="#2c2c2e" />
              <g fill="#3a3a3c">
                {Array.from({ length: 16 }, (_, k) => <rect x={24 + k * 6} y="4" width="4.4" height="5" rx="1" />)}
                {Array.from({ length: 13 }, (_, k) => <rect x={40 + k * 6} y="79" width="4.4" height="5" rx="1" />)}
              </g>
              <rect x="56" y="34" width="44" height="14" rx="2" fill="#2c2c2e" />
              <text x="62" y="66" fill="#efe4cc" font-family="Inter Variable, sans-serif" font-size="12" font-weight="700" letter-spacing="1">UNO</text>
              <circle cx="110" cy="66" r="2.5" fill="#efe4cc" class="pwr" />
            </svg>
          )}
          {p.id === 'led' && (
            <svg viewBox="0 0 22 50" class="led">
              <circle class="glow" cx="11" cy="11" r="11" />
              <path d="M5.5 26v24M16.5 26v20" stroke="#a8a294" stroke-width="2" />
              <rect x="3" y="22" width="16" height="5" rx="1.5" fill="#e6dccb" />
              <path class="lens" d="M4 23V11a7 7 0 0 1 14 0v12z" />
              <path d="M7 10a4 4 0 0 1 3-4" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round" opacity=".8" />
            </svg>
          )}
          {(p.id === 'res' || p.id === 'pull') && (
            <svg viewBox="0 0 54 14">
              <path d="M0 7h54" stroke="#a8a294" stroke-width="2" />
              <rect x="13" y="1" width="28" height="12" rx="5" fill="#e9dcc0" />
              {/* 220 Ω: red red brown; 10 kΩ pull-down: brown black orange */}
              <rect x="18" y="1" width="3" height="12" fill={p.id === 'res' ? '#b4562e' : '#6b4a2b'} />
              <rect x="24" y="1" width="3" height="12" fill={p.id === 'res' ? '#b4562e' : '#1d1d1f'} />
              <rect x="30" y="1" width="3" height="12" fill={p.id === 'res' ? '#6b4a2b' : '#c96a2b'} />
              <rect x="36" y="1" width="2" height="12" fill="#c9a24a" />
            </svg>
          )}
          {p.id === 'cap' && (
            <svg viewBox="0 0 22 38">
              <path d="M5.5 28v10M16.5 28v10" stroke="#a8a294" stroke-width="2" />
              <rect x="2" y="1" width="18" height="28" rx="4" fill="#1d1d1f" />
              <rect x="14" y="1" width="4" height="28" fill="#cfc8ba" />
              <ellipse cx="11" cy="3" rx="8" ry="2" fill="#3a3a3c" />
            </svg>
          )}
          {p.id === 'btn' && (
            <svg viewBox="0 0 30 30">
              <rect x="1" y="1" width="28" height="28" rx="3" fill="#1d1d1f" />
              <circle cx="15" cy="15" r="8" fill="#efe4cc" />
              <circle class="cap-top" cx="15" cy="15" r="5.5" fill="#e2d5bb" />
            </svg>
          )}
          {p.id === 'pot' && (
            <svg viewBox="0 0 34 40">
              <path d="M6 30v10M17 30v10M28 30v10" stroke="#a8a294" stroke-width="2" />
              <rect x="1" y="4" width="32" height="27" rx="3" fill="#e9dcc0" />
              <circle cx="17" cy="17" r="10" fill="#1d1d1f" />
              <path class="knob" data-knob d="M17 17V9" stroke="#efe4cc" stroke-width="2.5" stroke-linecap="round" />
            </svg>
          )}
          {p.id === 'buz' && (
            <svg viewBox="0 0 32 36">
              <g class="buzz">
                <path d="M-4 6q-5 9 0 18M-10 2q-8 13 0 26M36 6q5 9 0 18M42 2q8 13 0 26" />
              </g>
              <path d="M10.5 28v8M21.5 28v8" stroke="#a8a294" stroke-width="2" />
              <circle cx="16" cy="15" r="14.5" fill="#1d1d1f" />
              <circle cx="16" cy="15" r="3" fill="#3a3a3c" />
              <text x="4" y="9" fill="#efe4cc" font-family="Inter Variable, sans-serif" font-size="7" font-weight="700">+</text>
            </svg>
          )}
          {p.id === 'sonar' && (
            <svg viewBox="0 0 68 38">
              <path d="M17.5 30v8M28.5 30v8M39.5 30v8M50.5 30v8" stroke="#a8a294" stroke-width="1.6" />
              <rect x="1" y="6" width="66" height="25" rx="3" fill="#1d1d1f" />
              {[17, 51].map((cx) => (
                <g>
                  <circle cx={cx} cy="16" r="13" fill="#d9d4ca" />
                  <circle cx={cx} cy="16" r="9.5" fill="#2c2c2e" />
                  <circle cx={cx} cy="16" r="6" fill="#3a3a3c" stroke="#55534e" stroke-width=".8" stroke-dasharray="1.2 1.2" />
                </g>
              ))}
              <text x="25" y="29" fill="#efe4cc" font-family="Inter Variable, sans-serif" font-size="4.6" font-weight="700">HC-SR04</text>
            </svg>
          )}
          {p.id === 'oled' && (
            <svg viewBox="0 0 46 48">
              <path d="M6.5 40v8M17.5 40v8M28.5 40v8M39.5 40v8" stroke="#a8a294" stroke-width="1.6" />
              <rect x="1" y="1" width="44" height="40" rx="3" fill="#1d1d1f" />
              <rect x="5" y="6" width="36" height="24" rx="1" fill="#0b0b0c" />
              <text x="8" y="13" class="oled-label" data-oled-label>DISTANCE</text>
              <text x="8" y="24.5" class="oled-value" data-oled>-- cm</text>
              <rect x="8" y="27" width="30" height="1.6" fill="#2c2c2e" />
              <rect x="8" y="27" width="0" height="1.6" class="oled-bar" data-oled-bar />
              <g fill="#8d887c" font-family="Inter Variable, sans-serif" font-size="3.6" text-anchor="middle">
                <text x="6.5" y="37.5">GND</text>
                <text x="17.5" y="37.5">VCC</text>
                <text x="28.5" y="37.5">SCL</text>
                <text x="39.5" y="37.5">SDA</text>
              </g>
            </svg>
          )}
          {p.id === 'jumpers' && (
            <svg viewBox="0 0 56 72" class="jumpers">
              {[
                ['#1d1d1f', 'M12 9C10 30 15 46 12 62', 12, 12],
                ['#c9a46a', 'M28 9C27 28 31 44 27 62', 28, 27],
                ['#8a6d43', 'M44 9C46 30 41 46 45 62', 44, 45],
              ].map(([color, d, top, bottom], k) => (
                <g class="jw-fall" style={`--d:${0.5 + k * 0.22 + (p.n ?? 0) * 0.35}s;transform-origin:${top}px 4px`}>
                  <g class="jw" style={`transform-origin:${top}px 4px`}>
                    <path d={String(d)} stroke={String(color)} stroke-width="2.6" fill="none" stroke-linecap="round" />
                    <rect x={+top - 3} y="0" width="6" height="10" rx="1.2" fill="#2c2c2e" />
                    <rect x={+bottom - 3} y="60" width="6" height="10" rx="1.2" fill="#2c2c2e" />
                  </g>
                </g>
              ))}
            </svg>
          )}
          {p.id === 'nano' && (
            <svg viewBox="0 0 34 80">
              <rect x="1" y="1" width="32" height="78" rx="3" fill="#1d1d1f" />
              <rect x="11" y="-2" width="12" height="9" rx="1.5" fill="#cfc8ba" />
              <g fill="#3a3a3c">
                {Array.from({ length: 15 }, (_, k) => <circle cx="4.5" cy={12 + k * 4.5} r="1.4" />)}
                {Array.from({ length: 15 }, (_, k) => <circle cx="29.5" cy={12 + k * 4.5} r="1.4" />)}
              </g>
              <rect x="11" y="31" width="12" height="12" rx="1" fill="#2c2c2e" transform="rotate(45 17 37)" />
              <text x="17" y="62" text-anchor="middle" fill="#efe4cc" font-family="Inter Variable, sans-serif" font-size="6" font-weight="700">NANO</text>
            </svg>
          )}
          {p.id === 'pico' && (
            <svg viewBox="0 0 36 74">
              <rect x="1" y="1" width="34" height="72" rx="2" fill="#e9dcc0" />
              <rect x="12" y="-2" width="12" height="7" rx="1.5" fill="#cfc8ba" />
              <g fill="#fff" stroke="#c9a46a" stroke-width=".8">
                {Array.from({ length: 20 }, (_, k) => <circle cx="1.5" cy={6 + k * 3.4} r="1.2" />)}
                {Array.from({ length: 20 }, (_, k) => <circle cx="34.5" cy={6 + k * 3.4} r="1.2" />)}
              </g>
              <rect x="8" y="12" width="6" height="4" rx="1" fill="#bdb6a8" />
              <rect x="11" y="28" width="14" height="14" rx="1" fill="#1d1d1f" />
              <text x="18" y="57" text-anchor="middle" fill="#1d1d1f" font-family="Inter Variable, sans-serif" font-size="6" font-weight="800">PICO</text>
            </svg>
          )}
          {p.id === 'lcd' && (
            <svg viewBox="0 0 92 38">
              <rect x="1" y="1" width="90" height="36" rx="2" fill="#1d1d1f" />
              <g fill="#3a3a3c">
                <circle cx="4.5" cy="4.5" r="2" />
                <circle cx="87.5" cy="4.5" r="2" />
                <circle cx="4.5" cy="33.5" r="2" />
                <circle cx="87.5" cy="33.5" r="2" />
              </g>
              <rect x="9" y="6" width="74" height="26" rx="1.5" fill="#2c2c2e" />
              <rect x="12" y="9" width="68" height="20" rx="1" fill="#efe4cc" />
              <g fill="#1d1d1f" font-family="IBM Plex Mono, ui-monospace, monospace" font-size="6.4" font-weight="600">
                <text x="15" y="17.5">HELLO, WORLD!</text>
                <text x="15" y="26">ETTI UPB 2026</text>
              </g>
            </svg>
          )}
          {p.id === 'bat' && (
            <svg viewBox="0 0 34 56">
              <rect x="1" y="8" width="32" height="47" rx="3" fill="#1d1d1f" />
              <rect x="1" y="30" width="32" height="12" fill="#e9dcc0" />
              <text x="10" y="39.5" fill="#1d1d1f" font-family="Inter Variable, sans-serif" font-size="8" font-weight="800">9V</text>
              <rect x="6" y="2" width="8" height="7" rx="1" fill="#cfc8ba" />
              <rect x="20" y="2" width="9" height="7" rx="3" fill="#cfc8ba" />
            </svg>
          )}
          {p.id === 'servo' && (
            <svg viewBox="0 0 62 34">
              <rect x="8" y="8" width="46" height="24" rx="2" fill="#1d1d1f" />
              <rect x="1" y="14" width="60" height="5" rx="1.5" fill="#1d1d1f" />
              <circle cx="20" cy="8" r="7" fill="#2c2c2e" />
              <path d="M10 6h24" stroke="#efe4cc" stroke-width="4" stroke-linecap="round" />
              <circle cx="20" cy="6" r="2" fill="#1d1d1f" />
            </svg>
          )}
          {p.id === 'ic' && (
            <svg viewBox="0 0 42 24">
              <g stroke="#a8a294" stroke-width="2">
                {[9, 17, 25, 33].map((x) => <path d={`M${x} 0v4M${x} 20v4`} />)}
              </g>
              <rect x="3" y="4" width="36" height="16" rx="2" fill="#1d1d1f" />
              <circle cx="8" cy="12" r="2" fill="#3a3a3c" />
              <text x="15" y="14.5" fill="#efe4cc" font-family="Inter Variable, sans-serif" font-size="6" font-weight="700">555</text>
            </svg>
          )}
          {p.id === 'esp' && (
            <svg viewBox="0 0 52 100">
              <rect x="1" y="1" width="50" height="98" rx="5" fill="#1d1d1f" />
              <rect x="9" y="8" width="34" height="40" rx="2" fill="#d9d4ca" />
              <path d="M14 14h24M14 19h24M14 24h24" stroke="#bdb6a8" stroke-width="2" />
              <text x="15" y="42" fill="#7d776c" font-family="Inter Variable, sans-serif" font-size="7" font-weight="700">ESP32</text>
              <g fill="#3a3a3c">
                {Array.from({ length: 9 }, (_, k) => <circle cx="5" cy={54 + k * 5} r="1.6" />)}
                {Array.from({ length: 9 }, (_, k) => <circle cx="47" cy={54 + k * 5} r="1.6" />)}
              </g>
              <rect x="18" y="90" width="16" height="10" rx="1.5" fill="#cfc8ba" />
            </svg>
          )}
          {p.id === 'seg' && (
            <svg viewBox="0 0 30 42">
              <rect x="1" y="1" width="28" height="40" rx="2" fill="#1d1d1f" />
              <g fill="#e9dcc0">
                <rect x="9" y="6" width="12" height="2.6" rx="1" />
                <rect x="9" y="19.7" width="12" height="2.6" rx="1" />
                <rect x="9" y="33.4" width="12" height="2.6" rx="1" />
                <rect x="6.5" y="8.5" width="2.6" height="11" rx="1" />
                <rect x="20.9" y="8.5" width="2.6" height="11" rx="1" />
                <rect x="6.5" y="22.3" width="2.6" height="11" rx="1" />
                <rect x="20.9" y="22.3" width="2.6" height="11" rx="1" />
              </g>
              <circle cx="25" cy="36" r="1.4" fill="#e9dcc0" />
            </svg>
          )}
          {p.id === 'npn' && (
            <svg viewBox="0 0 20 32">
              <path d="M5 16v16M10 16v16M15 16v16" stroke="#a8a294" stroke-width="1.6" />
              <path d="M1 17V9a9 9 0 0 1 18 0v8z" fill="#1d1d1f" />
            </svg>
          )}
          {p.id === 'relay' && (
            <svg viewBox="0 0 46 34">
              <rect x="1" y="1" width="44" height="32" rx="2" fill="#1d1d1f" />
              <text x="7" y="15" fill="#efe4cc" font-family="Inter Variable, sans-serif" font-size="6.5" font-weight="700">RELAY</text>
              <text x="7" y="25" fill="#8d887c" font-family="Inter Variable, sans-serif" font-size="5">5V DC</text>
            </svg>
          )}
          {p.id === 'motor' && (
            <svg viewBox="0 0 40 40">
              <circle cx="20" cy="20" r="18" fill="#d9d4ca" />
              <circle cx="20" cy="20" r="12" fill="#cfc8ba" stroke="#bdb6a8" />
              <circle cx="20" cy="20" r="3" fill="#1d1d1f" />
              <rect x="6" y="34" width="6" height="5" fill="#b4562e" />
              <rect x="28" y="34" width="6" height="5" fill="#1d1d1f" />
            </svg>
          )}
          {p.id === 'diode' && (
            <svg viewBox="0 0 50 12">
              <path d="M0 6h50" stroke="#a8a294" stroke-width="2" />
              <rect x="14" y="1" width="22" height="10" rx="3" fill="#1d1d1f" />
              <rect x="30" y="1" width="3" height="10" fill="#d9d4ca" />
            </svg>
          )}
        </div>
      </div>
    ))
  }
</div>
<p class="bench-hint" data-hint>
  <span class="hint-mouse">Bring your cursor close to the sensor.</span><span class="hint-touch">Touch the screen near the sensor.</span>{' '}
  Click the knob to set the alarm distance and the button to switch the buzzer off.
</p>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const arcEl = stage.querySelector<HTMLElement>('[data-arc]')!;
  const benchEl = stage.querySelector<HTMLElement>('[data-bench]')!;
  const boardSvg = stage.querySelector<SVGSVGElement>('[data-board]')!;
  const wiresSvg = stage.querySelector<SVGSVGElement>('[data-wires]')!;
  const pingSvg = stage.querySelector<SVGSVGElement>('[data-pings]')!;
  const pingGroup = stage.querySelector<SVGGElement>('[data-ping-group]')!;
  const oledText = stage.querySelector<SVGTextElement>('[data-oled]')!;
  const oledLabel = stage.querySelector<SVGTextElement>('[data-oled-label]')!;
  const oledBar = stage.querySelector<SVGRectElement>('[data-oled-bar]')!;
  const knob = stage.querySelector<SVGPathElement>('[data-knob]')!;
  const allParts = [...stage.querySelectorAll<HTMLElement>('[data-part]')];
  const parts = allParts.filter((el) => !el.dataset.spare);
  const spares = allParts.filter((el) => el.dataset.spare);
  const jumpers = allParts.filter((el) => el.dataset.part === 'jumpers');
  const battery = allParts.find((el) => el.dataset.part === 'bat')!;
  const backRow = allParts.filter((el) => el.classList.contains('part--back') && !jumpers.includes(el));
  const frontRow = allParts.filter((el) => el.classList.contains('part--front') && !jumpers.includes(el));
  const leds = parts.filter((el) => el.dataset.part === 'led').sort((a, b) => +a.dataset.n! - +b.dataset.n!);
  const sonar = parts.find((el) => el.dataset.part === 'sonar')!;
  const buzzer = parts.find((el) => el.dataset.part === 'buz')!;
  const pot = parts.find((el) => el.dataset.part === 'pot')!;
  const button = parts.find((el) => el.dataset.part === 'btn')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NS = 'http://www.w3.org/2000/svg';
  // On phones the bench starts empty and the parts arrive one by one (no bouquet, no spare parts)
  const phone = !reduced && window.matchMedia('(max-width: 820px)').matches;

  type Pose = { x: number; y: number; r: number };
  type Pt = { x: number; y: number };
  const arcPoses = new Map<HTMLElement, Pose>();
  const benchPoses = new Map<HTMLElement, Pose>();
  const awayPoses = new Map<HTMLElement, Pose>();
  let cascade: HTMLElement[] = [];
  let centreShift = 0;
  let centred = false;
  let s = 1;

  function rel(el: HTMLElement) {
    const a = el.getBoundingClientRect();
    const b = stage.getBoundingClientRect();
    return { x: a.left - b.left, y: a.top - b.top, w: a.width, h: a.height };
  }
  function svgEl(tag: string, attrs: Record<string, string | number>) {
    const el = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    return el;
  }
  const size = (el: HTMLElement) => ({ w: +el.dataset.w! * s, h: +el.dataset.h! * s });

  // ----- Breadboard geometry: holes on a fixed pitch, rows like a real board -----
  // Rows, in pitches from the top: two power rails (GND, 5 V), rows a–e, the channel, rows f–j, two rails
  const ROW = {
    railTop: [1, 2],
    top: [3.6, 4.6, 5.6, 6.6, 7.6],
    bottom: [9.6, 10.6, 11.6, 12.6, 13.6],
    railBot: [15.2, 16.2],
  };
  const BOARD_H = 17.4;
  const CHANNEL = 8.6;
  let P = 11;
  let bx = 0;
  let cols = 30;
  const hx = (c: number) => bx + P * (1.5 + c);
  const hy = (r: number) => P * r;
  const ledCol = (k: number) => 1 + k * 3; // cathode column; the anode is one to the right

  function layoutBench(benchW: number) {
    s = Math.min(1.3, benchW / 560);
    P = 11 * s;
    bx = 136 * s;
    cols = Math.max(33, Math.floor((benchW - bx - 3 * P) / P));
    benchEl.style.height = `${BOARD_H * P}px`;
  }
  const unoTop = () => hy(BOARD_H / 2) - (88 * s) / 2;

  // Where each part lands, in bench coordinates (top-left corner) plus rotation.
  // Leg positions inside each drawing sit on the same 11-unit pitch as the holes.
  function benchSpot(id: string, n: number, w: number, h: number): Pose {
    switch (id) {
      case 'uno':
        return { x: 0, y: unoTop(), r: 0 };
      case 'led':
        // legs in row b: cathode in its column, anode one to the right
        return { x: hx(ledCol(n)) - 5.5 * s, y: hy(ROW.top[1]) - h + 1 * s, r: 0 };
      case 'res':
        // 220 Ω from the LED's cathode, across the channel, down to row f
        return { x: hx(ledCol(n)) - w / 2, y: hy(CHANNEL) - h / 2, r: 90 };
      case 'btn':
        return { x: hx(14) - w / 2, y: hy(CHANNEL) - h / 2, r: 0 };
      case 'pull':
        // 10 kΩ pull-down from the button's column to the top ground rail
        return { x: hx(16) - w / 2, y: hy(3.4) - h / 2, r: 90 };
      case 'buz':
        return { x: hx(18) - 10.5 * s, y: hy(ROW.top[4]) - h + 1 * s, r: 0 };
      case 'sonar':
        // VCC, Trig, Echo, GND in row e, columns 23–26, facing up towards the badge
        return { x: hx(23) - 17.5 * s, y: hy(ROW.top[4]) - h + 1 * s, r: 0 };
      case 'oled':
        // GND, VCC, SCL, SDA in row j, columns 17–20
        return { x: hx(17) - 6.5 * s, y: hy(ROW.bottom[4]) - h + 1 * s, r: 0 };
      case 'pot':
        return { x: hx(22) - 6 * s, y: hy(ROW.bottom[4]) - h + 1 * s, r: 0 };
      case 'cap':
        // 100 µF between 5 V and GND, next to the buzzer's supply
        return { x: hx(28) - 5.5 * s, y: hy(ROW.bottom[4]) - h + 1 * s, r: 0 };
      default:
        return { x: 0, y: 0, r: 0 };
    }
  }

  // One row of the bouquet: parts spaced along a half ellipse by their width, so the row
  // always fills the whole arc, whatever the screen size
  function placeRow(list: HTMLElement[], cx: number, cy: number, rx: number, ry: number, fan: number, seed: number) {
    const N = 240;
    const pts: { x: number; y: number; a: number; l: number }[] = [];
    for (let i = 0; i <= N; i++) {
      const a = Math.PI * (1 - (0.02 + 0.96 * (i / N)));
      const p = { x: cx + Math.cos(a) * rx, y: cy - Math.sin(a) * ry, a, l: 0 };
      if (i) p.l = pts[i - 1].l + Math.hypot(p.x - pts[i - 1].x, p.y - pts[i - 1].y);
      pts.push(p);
    }
    const total = pts[N].l;
    const widths = list.map((el) => Math.max(+el.dataset.w!, +el.dataset.h! * 0.7) * s);
    const sum = widths.reduce((a, b) => a + b, 0);
    let run = 0;
    let j = 0;
    list.forEach((el, i) => {
      const at = ((run + widths[i] / 2) / sum) * total;
      run += widths[i];
      while (j < N && pts[j + 1].l < at) j++;
      const p = pts[j];
      const t = at / total;
      const { w, h } = size(el);
      const wob = Math.sin(i * 2.3 + seed) * 5 * s;
      const x = p.x - Math.cos(p.a) * wob;
      const y = p.y + Math.sin(p.a) * wob;
      const r = (t - 0.5) * fan + Math.sin(i * 1.7 + seed) * 9;
      arcPoses.set(el, { x: x - w / 2, y: y - h / 2, r });
      // spares fly off to the right, far enough to clear the page, drifting up a little
      const out = Math.max(window.innerWidth, 900);
      awayPoses.set(el, {
        x: x - w / 2 + out * (0.9 + t * 0.3),
        y: y - h / 2 - out * (0.06 + Math.sin(i * 1.3 + seed) * 0.05),
        r: 120 + t * 160,
      });
    });
  }

  function layout() {
    layoutBench(benchEl.getBoundingClientRect().width);
    const arc = rel(arcEl);
    const bench = rel(benchEl);
    const cx = arc.x + arc.w / 2;
    const rx = arc.w / 2 - 30 * s;
    const ry = arc.h - 96 * s;
    placeRow(backRow, cx, arc.y + arc.h - 40 * s, rx, ry, 40, 0);
    placeRow(frontRow, cx, arc.y + arc.h - 28 * s, rx - 30 * s, ry - 40 * s, 64, 1);
    // Loose jumper wires hang from behind the 9 V battery, their top pins hidden by it
    const bat = arcPoses.get(battery)!;
    const batAway = awayPoses.get(battery)!;
    jumpers.forEach((el, k) => {
      const dx = (-11 + k * 7) * s;
      const dy = (24 + k * 5) * s;
      arcPoses.set(el, { x: bat.x + dx, y: bat.y + dy, r: 0 });
      awayPoses.set(el, { x: batAway.x + dx, y: batAway.y + dy, r: batAway.r });
    });
    for (const el of parts) {
      const { w, h } = size(el);
      const spot = benchSpot(el.dataset.part!, +(el.dataset.n || 0), w, h);
      benchPoses.set(el, { x: bench.x + spot.x, y: bench.y + spot.y, r: spot.r });
    }
    cascade = [...parts].sort((a, b) => benchPoses.get(a)!.x - benchPoses.get(b)!.x);
    for (const el of allParts) {
      const { w, h } = size(el);
      el.style.width = `${w}px`;
      el.style.height = `${h}px`;
    }
    drawBoard(bench.w);
    drawWires(bench.w);
    sizePings();
    // Distance that puts the circuit (Uno plus board) in the middle of the page
    centreShift = Math.round(stage.clientWidth / 2 - (bench.x + (bx + P * (cols + 3)) / 2));
    render();
  }

  function drawBoard(w: number) {
    const h = BOARD_H * P;
    boardSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    boardSvg.replaceChildren();
    const width = P * (cols + 3);
    boardSvg.append(svgEl('rect', { x: bx, y: 0, width, height: h, rx: 6 * s, class: 'bb' }));
    boardSvg.append(svgEl('rect', { x: bx + P, y: hy(CHANNEL) - 2.5 * s, width: width - 2 * P, height: 5 * s, rx: 2, class: 'channel' }));
    // Rail stripes: dark for ground, cream-brown for 5 V
    for (const [y, cls] of [
      [hy(0.4), 'rail-gnd'],
      [hy(2.6), 'rail-vcc'],
      [hy(14.6), 'rail-gnd'],
      [hy(16.8), 'rail-vcc'],
    ] as const) {
      boardSvg.append(svgEl('line', { x1: bx + P, x2: bx + width - P, y1: y, y2: y, class: cls }));
    }
    const rows = [...ROW.railTop, ...ROW.top, ...ROW.bottom, ...ROW.railBot];
    const rails = [...ROW.railTop, ...ROW.railBot];
    for (let c = 0; c < cols; c++) {
      for (const r of rows) {
        if (rails.includes(r) && c % 6 === 5) continue; // rail holes come in groups of five
        boardSvg.append(svgEl('rect', { x: hx(c) - 1.8 * s, y: hy(r) - 1.8 * s, width: 3.6 * s, height: 3.6 * s, rx: 0.8, class: 'hole' }));
      }
    }
  }

  // ----- Jumper wires, cable-managed: square runs with rounded corners, in lanes along the
  // top and bottom edges of the board, nested so no two wires cross. They pass under the parts.
  let wires: SVGPathElement[] = [];
  function route(pts: Pt[]) {
    const r = 4 * s;
    let d = `M${pts[0].x} ${pts[0].y}`;
    for (let i = 1; i < pts.length - 1; i++) {
      const [a, b, c] = [pts[i - 1], pts[i], pts[i + 1]];
      const l1 = Math.hypot(b.x - a.x, b.y - a.y) || 1;
      const l2 = Math.hypot(c.x - b.x, c.y - b.y) || 1;
      const k1 = Math.min(r, l1 / 2) / l1;
      const k2 = Math.min(r, l2 / 2) / l2;
      d += `L${b.x - (b.x - a.x) * k1} ${b.y - (b.y - a.y) * k1}Q${b.x} ${b.y} ${b.x + (c.x - b.x) * k2} ${b.y + (c.y - b.y) * k2}`;
    }
    const z = pts[pts.length - 1];
    return `${d}L${z.x} ${z.y}`;
  }
  function drawWires(w: number) {
    wiresSvg.setAttribute('viewBox', `0 0 ${w} ${BOARD_H * P}`);
    wiresSvg.replaceChildren();
    wires = [];
    const top = unoTop();
    // Uno headers. Top: SCL, SDA, AREF, GND, D13…D8, D7…D0. Bottom: IOREF, RESET, 3V3, 5V, GND, GND, VIN, A0…A5
    const topPin = (d: number): Pt => ({ x: (26.2 + (d >= 8 ? 4 + (13 - d) : 10 + (7 - d)) * 6) * s, y: top + 6.5 * s });
    const botPin = (k: number): Pt => ({ x: (42.2 + k * 6) * s, y: top + 81.5 * s });
    const BOT = { v5: 3, gnd: 4, a0: 7, a4: 11, a5: 12 };
    const hole = (c: number, r: number): Pt => ({ x: hx(c), y: hy(r) });
    const add = (pts: Pt[], cls: 'gnd' | 'vcc' | 'sig') => {
      const p = svgEl('path', { d: route(pts), pathLength: 1, class: `wire w-${cls}`, 'stroke-width': Math.max(1.3, 2.1 * s) });
      wiresSvg.append(p);
      wires.push(p as SVGPathElement);
    };
    const jumper = (c: number, r1: number, r2: number, cls: 'gnd' | 'vcc' | 'sig') => add([hole(c, r1), hole(c, r2)], cls);
    // Lane i of the top gutter (above the board) and of the bottom gutter (below it)
    const upLane = (i: number) => -(5 + i * 3.6) * s;
    const downLane = (i: number) => BOARD_H * P + (5 + i * 3.6) * s;
    // The leftmost pin takes the farthest hole and the outermost lane, so the runs nest
    const viaTop = (d: number, col: number, lane: number) => {
      const a = topPin(d);
      add([a, { x: a.x, y: upLane(lane) }, { x: hx(col), y: upLane(lane) }, hole(col, ROW.top[0])], 'sig');
    };
    const viaBottom = (k: number, col: number, row: number, lane: number, cls: 'gnd' | 'vcc' | 'sig') => {
      const a = botPin(k);
      add([a, { x: a.x, y: downLane(lane) }, { x: hx(col), y: downLane(lane) }, hole(col, row)], cls);
    };
    const last = cols - 1;

    // Power: Uno 5 V and GND to the bottom rails, then both rails bridged to the top ones
    viaBottom(BOT.v5, last, ROW.railBot[1], 4, 'vcc');
    viaBottom(BOT.gnd, last - 1, ROW.railBot[0], 3, 'gnd');
    jumper(last - 2, ROW.railBot[0], ROW.railTop[0], 'gnd');
    jumper(last - 3, ROW.railBot[1], ROW.railTop[1], 'vcc');
    // Bar graph: D6–D9 to the LED anodes, each cathode through 220 Ω to ground
    for (let k = 0; k < 4; k++) {
      viaTop(6 + k, ledCol(k) + 1, 3 - k);
      jumper(ledCol(k), ROW.bottom[4], ROW.railBot[0], 'gnd');
    }
    // Mute button on D10, held low by the 10 kΩ; its other leg goes to 5 V
    viaTop(10, 15, 4);
    add([hole(15, ROW.top[3]), hole(16, ROW.top[3])], 'sig');
    jumper(13, ROW.bottom[4], ROW.railBot[1], 'vcc');
    // Buzzer on D11
    viaTop(11, 18, 5);
    jumper(19, ROW.top[0], ROW.railTop[0], 'gnd');
    // HC-SR04: VCC, Trig on D12, Echo on D13, GND
    jumper(23, ROW.top[0], ROW.railTop[1], 'vcc');
    jumper(26, ROW.top[0], ROW.railTop[0], 'gnd');
    viaTop(12, 24, 6);
    viaTop(13, 25, 7);
    // OLED over I²C: GND, VCC, SCL to A5, SDA to A4
    jumper(17, ROW.bottom[4], ROW.railBot[0], 'gnd');
    jumper(18, ROW.bottom[4], ROW.railBot[1], 'vcc');
    viaBottom(BOT.a4, 20, ROW.bottom[4], 1, 'sig');
    viaBottom(BOT.a5, 19, ROW.bottom[4], 0, 'sig');
    // Alarm-distance pot: ends to the rails, wiper to A0
    jumper(22, ROW.bottom[4], ROW.railBot[0], 'gnd');
    jumper(24, ROW.bottom[4], ROW.railBot[1], 'vcc');
    viaBottom(BOT.a0, 23, ROW.bottom[4], 2, 'sig');
    // Smoothing capacitor across the supply
    jumper(28, ROW.bottom[4], ROW.railBot[1], 'vcc');
    jumper(29, ROW.bottom[4], ROW.railBot[0], 'gnd');
  }

  // ----- Assembly plays by itself: progress runs from 0 to 1 over a few seconds -----
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;
  const ASSEMBLE_MS = 3600;
  let current = reduced ? 1 : 0;
  let played = false;

  function pose(el: HTMLElement, a: Pose, b: Pose, t: number) {
    // Whole pixels once a part has landed, so it never shimmers between two pixels
    const snap = t === 0 || t === 1 ? Math.round : (v: number) => v;
    el.style.transform = `translate(${snap(mix(a.x, b.x, t))}px, ${snap(mix(a.y, b.y, t))}px) rotate(${mix(a.r, b.r, t)}deg)`;
  }

  function render() {
    const asm = current;
    const n = parts.length;
    const stagger = 0.032;
    // A cascade from left to right: the part going furthest left on the board moves first
    cascade.forEach((el, i) => {
      if (phone) {
        // Phones: one part after another glides down onto the board, slowing as it lands
        const span = 0.2;
        const raw = clamp01((asm - (i * (1 - span)) / Math.max(1, n - 1)) / span);
        const t = 1 - Math.pow(1 - raw, 3);
        const to = benchPoses.get(el)!;
        pose(el, { x: to.x, y: to.y - 34 * s, r: to.r - 7 }, to, t);
        el.style.opacity = String(Math.min(1, raw * 2.5));
        return;
      }
      const t = ease(clamp01((asm - i * stagger) / (1 - (n - 1) * stagger)));
      pose(el, arcPoses.get(el)!, benchPoses.get(el)!, t);
    });
    // Spare parts are the first to go, flung off the page
    spares.forEach((el, i) => {
      const t = ease(clamp01((asm - i * 0.022) / 0.4));
      pose(el, arcPoses.get(el)!, awayPoses.get(el)!, t);
      el.style.opacity = phone ? '0' : String(1 - t);
      el.style.visibility = phone || t >= 1 ? 'hidden' : '';
    });
    benchEl.style.opacity = String(0.4 + 0.6 * Math.min(1, asm * 1.4));
    stage.classList.toggle('moving', asm > 0.02 && asm < 0.99);
    centred = asm >= 1;
    stage.style.transform = centred ? `translateX(${centreShift}px)` : '';
    // Wires start once most parts are down, so nobody waits for the last one
    setWired(asm >= 0.9);
  }

  // The wires draw themselves, one after another, at their own pace; then the circuit turns on
  const WIRE_GAP = 0.09;
  const WIRE_TIME = 0.9;
  let wired = false;
  let liveTimer = 0;
  function setWired(on: boolean) {
    if (on === wired) return;
    wired = on;
    clearTimeout(liveTimer);
    wires.forEach((w, i) => (w.style.transitionDelay = on ? `${0.2 + i * WIRE_GAP}s` : '0s'));
    stage.classList.toggle('wired', on);
    if (on) liveTimer = window.setTimeout(() => setLive(true), (0.2 + wires.length * WIRE_GAP + WIRE_TIME) * 1000);
    else setLive(false);
  }

  function play() {
    if (played || reduced) return;
    played = true;
    const start = performance.now() + (phone ? 250 : 700); // let the bouquet settle in for a moment first
    const step = (now: number) => {
      current = clamp01((now - start) / (phone ? 4800 : ASSEMBLE_MS));
      render();
      if (current < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // ----- The live circuit: the sonar measures the distance to your cursor (or finger) -----
  // The pot sets the alarm distance (one step per tap), the button mutes the buzzer
  const ALARMS = [30, 60, 90, 120, 150];
  let alarmStep = 3;
  let muted = false;
  let noteUntil = 0;
  let live = false;
  let liveFrame = 0;
  let nextBeep = 0;
  let shown = '';
  let cmPerPx = 0;
  let litBefore = 0;
  const BEEP_GAP = [0, 650, 380, 190, 95]; // ms between beeps for 1–4 LEDs
  const alarm = () => ALARMS[alarmStep];
  function turnKnob() {
    knob.style.transform = `rotate(${-120 + (alarmStep / (ALARMS.length - 1)) * 240}deg)`;
  }

  function setLive(on: boolean) {
    live = on;
    stage.classList.toggle('live', on);
    window.dispatchEvent(new CustomEvent('circuit-live', { detail: on }));
    cancelAnimationFrame(liveFrame);
    cmPerPx = 0;
    if (on) {
      liveFrame = requestAnimationFrame(liveLoop);
    } else {
      leds.forEach((l) => l.classList.remove('on'));
      oledLabel.textContent = 'DISTANCE';
      oledText.textContent = '-- cm';
      shown = '';
    }
  }

  // Where the pointer is, in page coordinates; null when it's away and the sensor looks at
  // a resting spot up and to the right
  let pointer: Pt | null = null;
  let pointerTimer = 0;
  window.addEventListener('pointermove', (e) => {
    clearTimeout(pointerTimer);
    pointer = { x: e.clientX, y: e.clientY + window.scrollY };
    // A finger lifts off; let the reading drift back after a moment
    if (e.pointerType !== 'mouse') pointerTimer = window.setTimeout(() => (pointer = null), 1500);
  });
  window.addEventListener('pointerdown', (e) => {
    clearTimeout(pointerTimer);
    pointer = { x: e.clientX, y: e.clientY + window.scrollY };
    if (e.pointerType !== 'mouse') pointerTimer = window.setTimeout(() => (pointer = null), 1500);
  });
  document.documentElement.addEventListener('pointerleave', () => (pointer = null));

  const REST_PX = 330; // the resting spot reads 120 cm
  function measure() {
    const r = sonar.getBoundingClientRect();
    const from = { x: r.left + r.width / 2, y: r.top + r.height * 0.3 };
    const to = pointer
      ? { x: pointer.x, y: pointer.y - window.scrollY }
      : { x: from.x + REST_PX * 0.6 * s, y: from.y - REST_PX * 0.8 * s };
    const px = Math.hypot(to.x - from.x, to.y - from.y);
    if (!cmPerPx) cmPerPx = 120 / (REST_PX * s);
    return { from, to, cm: Math.max(2, Math.min(400, Math.round(px * cmPerPx))) };
  }

  function liveLoop(now: number) {
    liveFrame = requestAnimationFrame(liveLoop);
    const { from, to, cm } = measure();
    // Point the ping arcs from the sonar towards the badge
    const sr = stage.getBoundingClientRect();
    const angle = (Math.atan2(to.y - from.y, to.x - from.x) * 180) / Math.PI;
    pingGroup.setAttribute('transform', `translate(${from.x - sr.left} ${from.y - sr.top}) rotate(${angle}) scale(${s})`);
    const ratio = cm / alarm();
    // Bar graph: the closer the pointer (relative to the alarm distance), the more LEDs
    // Evenly spread steps, so you have to come right up to the sensor for all four
    const lit = ratio < 0.25 ? 4 : ratio < 0.45 ? 3 : ratio < 0.65 ? 2 : ratio < 0.85 ? 1 : 0;
    const setting = now < noteUntil;
    const key = `${cm}|${alarmStep}|${muted}|${setting}`;
    if (key !== shown) {
      shown = key;
      oledLabel.textContent = setting ? 'ALARM AT' : muted ? 'BUZZ OFF' : 'DISTANCE';
      oledText.textContent = `${setting ? alarm() : cm} cm`;
      oledBar.setAttribute('width', String(30 * (1 - Math.min(1, ratio))));
      leds.forEach((l, k) => l.classList.toggle('on', k < lit));
    }
    // Parking-sensor beeps, one rhythm per LED step. A new LED beeps straight away,
    // so the buzzer reacts the moment the badge comes closer
    if (lit > litBefore) nextBeep = now;
    litBefore = lit;
    if (!muted && lit > 0 && now >= nextBeep) {
      nextBeep = now + BEEP_GAP[lit];
      buzzer.classList.remove('beep');
      void buzzer.offsetWidth;
      buzzer.classList.add('beep');
    }
  }

  // Pause the live loop while the circuit is off screen
  new IntersectionObserver(([entry]) => {
    cancelAnimationFrame(liveFrame);
    if (entry.isIntersecting && live) liveFrame = requestAnimationFrame(liveLoop);
  }).observe(benchEl);

  // A tap on a phone lifts the part like a hover does
  allParts.forEach((el) =>
    el.addEventListener('pointerdown', () => {
      el.classList.add('tapped');
      setTimeout(() => el.classList.remove('tapped'), 500);
    }),
  );
  pot.addEventListener('click', () => {
    if (!live) return;
    alarmStep = (alarmStep + 1) % ALARMS.length;
    noteUntil = performance.now() + 1400;
    turnKnob();
  });
  button.addEventListener('click', () => {
    if (!live) return;
    muted = !muted;
    button.classList.toggle('muted', muted);
  });

  function sizePings() {
    const r = stage.getBoundingClientRect();
    pingSvg.setAttribute('viewBox', `0 0 ${r.width} ${r.height}`);
  }

  // Phones resize the viewport when their toolbars slide in and out while scrolling; only a
  // real width change needs a new layout, otherwise the parts would jump on every scroll
  let lastWidth = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastWidth && matchMedia('(pointer: coarse)').matches) return;
    lastWidth = window.innerWidth;
    layout();
  });
  document.fonts?.ready.then(layout);
  turnKnob();
  layout();
  stage.classList.add('ready');
  // Starts by itself as soon as the bench is on screen
  new IntersectionObserver(([entry], obs) => {
    if (!entry.isIntersecting) return;
    obs.disconnect();
    play();
  }, { threshold: 0.3 }).observe(stage);
</script>

