---
// Static ID badge on a lanyard with a CSS drop-and-swing intro.
// Placeholder for the 3D physics version that comes later.
---

<div class="badge-scene" aria-hidden="true">
  <div class="badge-swing">
    <div class="strap"></div>
    <div class="clip"></div>
    <div class="card">
      <div class="hole"></div>
      <div class="photo"></div>
      <div class="name">Matei Iliuță</div>
      <div class="role">Electronics student</div>
      <div class="meta">
        <span>ETTI · UPB</span>
        <span>Year 1</span>
      </div>
    </div>
  </div>
</div>

<style>
  .badge-scene {
    position: relative;
    height: 520px;
    display: flex;
    justify-content: center;
    overflow: visible;
  }
  .badge-swing {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    animation:
      drop 0.9s cubic-bezier(0.2, 0.9, 0.3, 1.25) both,
      swing 3.2s ease-in-out 0.9s both;
  }
  .strap {
    width: 22px;
    height: 220px;
    margin-top: -60px;
    background: linear-gradient(90deg, #2c2c2e, #1d1d1f 50%, #2c2c2e);
    border-radius: 0 0 4px 4px;
  }
  .clip {
    width: 34px;
    height: 22px;
    margin-top: -4px;
    border-radius: 6px;
    background: linear-gradient(#e5e5ea, #aeaeb2);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }
  .card {
    position: relative;
    width: 230px;
    margin-top: -6px;
    padding: 34px 22px 22px;
    border-radius: 20px;
    background: #0d0d0f;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.06),
      0 24px 50px -12px rgba(0, 0, 0, 0.22);
    text-align: center;
  }
  .hole {
    position: absolute;
    top: 12px;
    left: 50%;
    width: 40px;
    height: 8px;
    transform: translateX(-50%);
    border-radius: 4px;
    background: var(--bg-soft);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  .photo {
    width: 120px;
    height: 140px;
    margin: 0 auto 18px;
    border-radius: 12px;
    background: #1a1a1d url('/badge-photo.jpg') center / cover;
    display: grid;
    place-items: center;
    font-size: 36px;
    font-weight: 700;
    color: #aeaeb2;
  }
  .name {
    font-family: 'Great Vibes', cursive;
    font-size: 30px;
    color: #f3e9d2;
  }
  .role {
    font-size: 13px;
    color: rgba(243, 233, 210, 0.7);
    margin-top: 2px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px solid rgba(243, 233, 210, 0.18);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(243, 233, 210, 0.75);
  }

  @keyframes drop {
    from {
      transform: translateY(-110%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes swing {
    0% { transform: rotate(0deg); }
    15% { transform: rotate(7deg); }
    35% { transform: rotate(-5deg); }
    55% { transform: rotate(3deg); }
    75% { transform: rotate(-1.5deg); }
    100% { transform: rotate(0deg); }
  }
  @media (max-width: 820px) {
    .badge-scene {
      height: 440px;
      margin-top: 24px;
    }
    .strap {
      height: 110px;
      margin-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-swing {
      animation: none;
    }
  }
</style>
