---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/events/', label: 'Events' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href="/">Matei Iliuță</a>
    <nav class="pill">
      {links.map((link) => (
        <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>
      ))}
      <span class="slider" aria-hidden="true"></span>
    </nav>
  </div>
</header>

<script>
  // Cream pill that slides under the hovered link, then back to the current page
  const nav = document.querySelector<HTMLElement>('header.nav .pill');
  if (nav) {
    const slider = nav.querySelector<HTMLElement>('.slider')!;
    const active = nav.querySelector<HTMLElement>('a.active');
    const go = (a: HTMLElement | null, instant = false) => {
      if (!a) {
        slider.style.opacity = '0';
        return;
      }
      if (instant) slider.style.transition = 'none';
      slider.style.opacity = '1';
      slider.style.transform = `translateX(${a.offsetLeft}px)`;
      slider.style.width = `${a.offsetWidth}px`;
      if (instant) requestAnimationFrame(() => (slider.style.transition = ''));
    };
    nav.querySelectorAll<HTMLElement>('a').forEach((a) => a.addEventListener('mouseenter', () => go(a)));
    nav.addEventListener('mouseleave', () => go(active));
    go(active, true);
    window.addEventListener('load', () => go(active, true));
    window.addEventListener('resize', () => go(active, true));
    // On phones the pill scrolls sideways: keep the current page in view
    if (active && nav.scrollWidth > nav.clientWidth) nav.scrollLeft = active.offsetLeft - (nav.clientWidth - active.offsetWidth) / 2;
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 12px 0;
    background: linear-gradient(to bottom, rgba(18, 17, 16, 0.85), rgba(18, 17, 16, 0));
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo {
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }
  .logo:hover {
    text-decoration: none;
  }
  /* Frosted glass pill, Apple style */
  .pill {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(40, 37, 33, 0.55);
    border: 1px solid var(--glass-line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 10px 30px -12px rgba(0, 0, 0, 0.7);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    backdrop-filter: blur(40px) saturate(180%);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pill::-webkit-scrollbar {
    display: none;
  }
  .pill a {
    position: relative;
    z-index: 1;
    padding: 7px 14px;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 14px;
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .pill a:hover,
  .pill a.active {
    color: var(--text);
    text-decoration: none;
  }
  .slider {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: rgba(255, 248, 235, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    opacity: 0;
    transition:
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s ease;
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .logo {
      display: none;
    }
    .nav-inner {
      justify-content: center;
    }
    .pill a {
      padding: 7px 11px;
      font-size: 13px;
    }
  }
  /* Phones: all six links fit on one line, nothing wraps or hides */
  @media (max-width: 440px) {
    .nav-inner {
      padding: 0 10px;
    }
    .pill {
      padding: 4px;
      gap: 0;
    }
    .slider {
      top: 4px;
      bottom: 4px;
    }
    .pill a {
      padding: 7px clamp(5px, 2.1vw, 10px);
      font-size: clamp(11.5px, 3.3vw, 13px);
      letter-spacing: -0.01em;
    }
  }
</style>
