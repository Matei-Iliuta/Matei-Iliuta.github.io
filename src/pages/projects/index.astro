---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyProjects from '../../components/EmptyProjects.astro';
import Workbench from '../../components/Workbench.astro';

const projects = (await getCollection('projects', (p) => p.data.status === 'completed' && !p.data.parent)).sort(
  (a, b) => a.data.order - b.data.order,
);
const building = (await getCollection('projects', (p) => p.data.status === 'in-progress' && !p.data.parent)).sort(
  (a, b) => b.data.order - a.data.order,
);
---

<Base title="Projects">
  <section class="container page">
    <p class="eyebrow">Projects</p>
    <h1>Things I've <span class="mark">built.<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8 C 40 3, 90 11, 140 6 S 190 5, 198 7"></path></svg></span></h1>
    <p class="lead">Small for now, documented properly. Every finished project gets its own page.</p>
    <div class="workbench">
      <Workbench />
    </div>
    {
      projects.length ? (
        <div class="grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <EmptyProjects />
      )
    }
    {
      building.length > 0 && (
        <>
          <h2 class="sub reveal">Building <span class="mark">now<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8 C 40 3, 90 11, 140 6 S 190 5, 198 7"></path></svg></span></h2>
          <div class="grid">
            {building.map((project) => <ProjectCard project={project} />)}
          </div>
        </>
      )
    }
  </section>
</Base>

<style>
  /* Spare parts fly off to the right; they're cut off here so they can never make the page
     wider than the screen (iOS Safari lets you pan sideways to anything that sticks out) */
  .workbench {
    margin: 0 0 64px;
    overflow-x: clip;
    overflow-clip-margin: 24px;
  }
  .page {
    padding-top: 100px;
  }
  h1 {
    font-size: var(--fs-page-h1);
    margin: 12px 0 16px;
  }
  .lead {
    font-size: var(--fs-lead);
    color: var(--text-muted);
    margin: 0 0 48px;
  }
  .sub {
    font-size: var(--fs-h3, 24px);
    margin: 64px 0 20px;
  }
  /* Phones: the cards come first, the animated bench moves below them */
  @media (max-width: 820px) {
    .page {
      display: flex;
      flex-direction: column;
    }
    .workbench {
      order: 10;
      margin: 56px 0 0;
    }
    .lead {
      margin-bottom: 28px;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
</style>
