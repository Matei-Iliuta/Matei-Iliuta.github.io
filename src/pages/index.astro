---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lanyard from '../components/Lanyard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EmptyProjects from '../components/EmptyProjects.astro';
import NowCards from '../components/NowCards.astro';
import Timeline from '../components/Timeline.astro';

// Real numbers for the hero, counted from the content
const allProjects = await getCollection('projects', (p) => !p.data.parent);
const current = allProjects.find((p) => p.data.status === 'in-progress');
const projects = (await getCollection('projects', (p) => p.data.status === 'completed' && !p.data.parent)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <section class="hero container">
    <div class="frame" data-liquid>
      <div class="liquid" aria-hidden="true">
        <span class="blob blob--a"></span>
        <span class="blob blob--b"></span>
        <svg class="wave" viewBox="0 0 600 800" preserveAspectRatio="none">
          <defs>
            <linearGradient id="wave-fill" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#f1e8d8" stop-opacity="0"></stop>
              <stop offset="0.5" stop-color="#f6e6c4" stop-opacity="0.55"></stop>
              <stop offset="1" stop-color="#f1e8d8" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path
            fill="url(#wave-fill)"
            d="M150 0 C 60 130, 250 260, 130 400 S 230 660, 110 800 L 430 800 C 540 660, 350 540, 470 400 S 370 130, 490 0 Z"
          ></path>
        </svg>
      </div>
      <p class="eyebrow">Electronics student · ETTI UPB</p>
      <h1><span>Matei Iliuță</span></h1>
      <Lanyard photo="/badge-photo.jpg" />
      <div class="bottom">
        <div class="lead">
          <div class="cta">
            <div class="actions">
              <a class="button go" href="/projects/"
                >See my projects<span class="arrow" aria-hidden="true">↗</span></a
              >
              <a class="button secondary" href="/cv/matei-iliuta-cv.pdf">Download CV</a>
              <a class="social glass" href="https://github.com/Matei-Iliuta" target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
              </a>
              <a class="social glass" href="https://www.linkedin.com/in/matei-iliu%C8%9B%C4%83-853561442" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11.5H3zM9.75 9.75h3.83v1.57h.05c.53-1 1.84-2.07 3.79-2.07 4.05 0 4.8 2.67 4.8 6.13v5.87h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4z"/></svg>
              </a>
            </div>
            <p class="tagline">
              First year at ETTI UPB. Learning C, wiring up boards, and trying to figure out <span class="mark"
                >why they work.<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"
                  ><path d="M2 8 C 40 3, 90 11, 140 6 S 190 5, 198 7"></path></svg
                ></span
              >
            </p>
          </div>
        </div>
        {
          current && (
            <a class="mini glass" href={`/projects/${current.id}/`}>
              <span class="mini-top">
                <span class="dot" />
                On my bench
              </span>
              <strong>{current.data.title}</strong>
              <span class="mini-bar">
                <span style={`width: ${current.data.progress}%`} />
              </span>
              <span class="mini-pct">{current.data.progress}% · see progress ›</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <script>
    // Liquid light: two soft blobs glide after the cursor (or finger). Each one eases towards
    // the pointer on every frame, moved only with transforms, so it stays smooth.
    const frame = document.querySelector<HTMLElement>('[data-liquid]');
    if (frame && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const blobs = [...frame.querySelectorAll<HTMLElement>('.blob')].map((el, i) => ({
        el,
        x: 0,
        y: 0,
        k: i === 0 ? 0.16 : 0.07, // the second drop trails behind
        dx: i === 0 ? 0 : 70,
        dy: i === 0 ? 0 : 50,
      }));
      let tx = frame.clientWidth * 0.3;
      let ty = frame.clientHeight * 0.36;
      blobs.forEach((b) => {
        b.x = tx;
        b.y = ty;
      });
      let running = false;
      const tick = () => {
        let moving = false;
        for (const b of blobs) {
          const gx = tx + b.dx;
          const gy = ty + b.dy;
          b.x += (gx - b.x) * b.k;
          b.y += (gy - b.y) * b.k;
          if (Math.abs(gx - b.x) > 0.3 || Math.abs(gy - b.y) > 0.3) moving = true;
          b.el.style.transform = `translate3d(${b.x}px, ${b.y}px, 0)`;
        }
        if (moving) requestAnimationFrame(tick);
        else running = false;
      };
      const start = () => {
        if (running) return;
        running = true;
        requestAnimationFrame(tick);
      };
      frame.addEventListener(
        'pointermove',
        (e) => {
          const r = frame.getBoundingClientRect();
          tx = e.clientX - r.left;
          ty = e.clientY - r.top;
          start();
        },
        { passive: true },
      );
      start();
    }
  </script>

  <p class="bridge container reveal">
    Loose parts, <span class="mark mark--late"
      >one wire at a time.<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"
        ><path d="M2 8 C 40 3, 90 11, 140 6 S 190 5, 198 7"></path></svg
      ></span
    >
    <span class="bridge-rest">Here's what's on my bench right now.</span>
  </p>

  <NowCards />

  <section class="container section">
    <div class="section-head reveal">
      <h2><span class="mark">Projects<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8 C 40 3, 90 11, 140 6 S 190 5, 198 7"></path></svg></span></h2>
      <a href="/projects/">View all ›</a>
    </div>
    {
      projects.length ? (
        <div class="grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <EmptyProjects />
      )
    }
  </section>

  <Timeline />

  <section class="container section about-teaser reveal">
    <h2>It started with a <span class="mark">frog-shaped calculator.<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8 C 40 3, 90 11, 140 6 S 190 5, 198 7"></path></svg></span></h2>
    <p>I opened it up, found a small green PCB, and couldn't understand how something that small could do math.</p>
    <a href="/about/">Read the rest ›</a>
  </section>
</Base>

<style>
  /* Hero: one big rounded frame, the name huge behind the hanging badge */
  .hero {
    padding-top: 8px;
  }
  .frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: min(860px, calc(100svh - 96px));
    padding: 28px 40px 36px;
    border-radius: 36px;
    border: 1px solid var(--glass-line);
    background:
      radial-gradient(60% 55% at 50% 0%, rgba(232, 211, 168, 0.16), transparent 70%),
      radial-gradient(40% 40% at 85% 85%, rgba(200, 150, 90, 0.1), transparent 70%),
      linear-gradient(180deg, #1d1a17, #141210);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 40px 80px -40px rgba(0, 0, 0, 0.9);
  }
  /* Fine dot grid, like a perfboard, fading towards the bottom */
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(241, 232, 216, 0.09) 1px, transparent 1.4px);
    background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
  }
  /* Liquid light inside the frame */
  .liquid {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    left: 0;
    top: 0;
    width: min(46%, 520px);
    aspect-ratio: 1;
    /* centred on the point the script moves it to */
    margin: calc(min(46%, 520px) / -2) 0 0 calc(min(46%, 520px) / -2);
    transform: translate3d(30%, 36%, 0);
    will-change: transform;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 234, 196, 0.2),
      rgba(232, 190, 130, 0.09) 45%,
      transparent 70%
    );
    /* the shape keeps changing, like a drop of liquid */
    animation: morph 9s ease-in-out infinite alternate;
  }
  /* A smaller drop that trails behind the first one */
  .blob--b {
    width: min(28%, 320px);
    margin: calc(min(28%, 320px) / -2) 0 0 calc(min(28%, 320px) / -2);
    background: radial-gradient(circle at 50% 50%, rgba(255, 244, 222, 0.16), rgba(214, 170, 110, 0.07) 48%, transparent 70%);
    animation-duration: 7s;
    animation-delay: -3s;
  }
  @keyframes morph {
    0% {
      border-radius: 58% 42% 55% 45% / 46% 58% 42% 54%;
    }
    50% {
      border-radius: 42% 58% 38% 62% / 60% 40% 62% 38%;
    }
    100% {
      border-radius: 52% 48% 64% 36% / 38% 56% 44% 62%;
    }
  }
  /* On load, a wave of liquid light slides once across the whole hero */
  .wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 75%;
    height: 100%;
    filter: blur(10px);
    transform: translateX(-130%);
    animation: slide 2.1s cubic-bezier(0.65, 0.05, 0.2, 1) 0.35s both;
  }
  @keyframes slide {
    to {
      transform: translateX(240%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob,
    .wave {
      animation: none;
    }
    .wave {
      display: none;
    }
  }
  .eyebrow {
    position: relative;
    z-index: 2;
    margin: 0;
  }
  h1 {
    position: relative;
    /* In front of the badge: the strap and the card hang behind the letters */
    z-index: 2;
    pointer-events: none;
    margin: 4vh 0 0;
    text-align: center;
    font-size: clamp(56px, 14vw, 200px);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.95;
    white-space: nowrap;
  }
  h1 span {
    background: linear-gradient(180deg, rgba(241, 232, 216, 0.98) 15%, rgba(241, 232, 216, 0.62) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* room for the comma under the ț, which the clip would otherwise cut */
    padding-bottom: 0.12em;
  }
  .frame > :global(.lanyard) {
    position: absolute;
    inset: 0;
    z-index: 1;
    min-height: 0;
  }
  .frame > :global(.lanyard .fallback) {
    display: flex;
    justify-content: center;
  }
  .bottom {
    position: relative;
    z-index: 2;
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    pointer-events: none;
  }
  .bottom a {
    pointer-events: auto;
  }
  /* Under the badge: the sentence, then one tidy row of buttons; the bench card on the right */
  .cta {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 22px;
  }
  .tagline {
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 40ch;
    margin: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  /* every control in the row is the same height */
  .actions .button {
    height: 48px;
    padding-top: 0;
    padding-bottom: 0;
  }
  /* GitHub and LinkedIn: small round glass buttons next to the main ones */
  .social {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--text);
    background: var(--glass);
    border: 1px solid var(--glass-line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s ease, color 0.3s ease;
  }
  .social:hover {
    text-decoration: none;
    transform: translateY(-3px);
    background: var(--cream);
    color: #141210;
  }
  .button.go {
    padding-right: 9px;
    gap: 12px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #141210;
    color: var(--cream);
    font-size: 14px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .button.go:hover .arrow {
    transform: rotate(45deg);
  }
  /* Small glass card in the corner: what's on the bench right now */
  .mini {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 250px;
    padding: 16px 18px;
    border-radius: 22px;
    background: rgba(255, 248, 235, 0.07);
    border: 1px solid var(--glass-line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 20px 40px -20px rgba(0, 0, 0, 0.8);
    color: var(--text);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s ease;
  }
  .mini:hover {
    text-decoration: none;
    transform: translateY(-4px);
    background: rgba(255, 248, 235, 0.11);
  }
  .mini-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #9cc08a;
    box-shadow: 0 0 0 4px rgba(156, 192, 138, 0.18);
  }
  .mini strong {
    font-size: 18px;
  }
  .mini-bar {
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 248, 235, 0.12);
    overflow: hidden;
  }
  .mini-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #8db37a;
  }
  .mini-pct {
    font-size: 12px;
    color: var(--text-muted);
  }
  /* The line between the circuit and "Right now", centred, underline drawn as it appears */
  .bridge {
    margin: 0 auto;
    padding-top: 110px;
    max-width: 24ch;
    text-align: center;
    font-size: clamp(28px, 4.2vw, min(56px, max(44px, 2.8vw)));
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .bridge-rest {
    display: block;
    margin-top: 10px;
    font-size: 0.55em;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-muted);
  }
  .mark--late path {
    animation: none;
  }
  .bridge:global(.visible) .mark--late path {
    animation: draw 0.9s ease-out 0.5s forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .mark--late path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
  .section {
    padding-top: 80px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 28px;
  }
  h2 {
    font-size: var(--fs-h2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .about-teaser {
    text-align: center;
    padding-top: 140px;
  }
  .about-teaser p {
    font-size: var(--fs-lead);
    color: var(--text-muted);
    max-width: 36ch;
    margin: 20px auto;
  }
  @media (max-width: 820px) {
    .hero {
      padding: 4px 12px 0;
    }
    .frame {
      min-height: 860px;
      padding: 22px 20px 24px;
      border-radius: 30px;
      text-align: center;
    }
    h1 {
      font-size: 13.4vw;
      margin-top: 18px;
    }
    .frame > :global(.lanyard) {
      bottom: auto;
      height: 480px;
    }
    .bottom {
      flex-direction: column;
      align-items: stretch;
    }
    .cta {
      align-items: center;
    }
    .actions {
      justify-content: center;
    }
    .tagline {
      text-align: center;
    }
    /* The bench card sits between the badge and the buttons */
    .mini {
      order: -1;
      width: auto;
      text-align: left;
    }
    .bottom {
      gap: 18px;
    }
  }
</style>
