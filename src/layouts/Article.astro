---
import ScrollTop from '../components/ScrollTop.astro';
// Layout for blog articles. Same frame as the project pages (fonts, cream, centred header,
// numbered sections), so a story and a project read like parts of the same site.
import '@fontsource-variable/inter';
import '../styles/project.css';

interface Props {
  title: string;
  description: string;
  date: string; // YYYY-MM-DD
  kicker?: string; // small pill above the title, e.g. "Competition · 5th place"
  meta?: { label: string; value: string }[];
  stack?: string[];
  back?: { href: string; label: string };
}

const { title, description, date, kicker, meta = [], stack = [], back = { href: '/events/', label: 'Back to Events' } } = Astro.props;
const pretty = new Date(date + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Matei Iliuță</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121110" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <ScrollTop />
  </head>
  <body class="pp-body article-body">
    <div class="pp">
      <div class="pp-container">
        <nav class="pp-nav" aria-label="Site">
          <a href="/" class="pp-logo">matei<span class="accent">_</span></a>
          <a href={back.href} class="pp-back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
            {back.label}
          </a>
        </nav>

        <header class="pp-header">
          {kicker && <div class="status status--done">{kicker}</div>}
          <h1 class="pp-title">{title}</h1>
          <p class="pp-summary">{description}</p>
          <div class="meta">
            <div class="meta-item"><span class="meta-label">DATE</span><time class="meta-value" datetime={date}>{pretty}</time></div>
            {meta.map((m) => (
              <div class="meta-item"><span class="meta-label">{m.label.toUpperCase()}</span><span class="meta-value">{m.value}</span></div>
            ))}
          </div>
          {stack.length > 0 && <div class="chips mono article-stack">{stack.map((s) => <span class="chip">{s}</span>)}</div>}
        </header>

        <slot />

        <footer class="pp-footer">
          <a href={back.href} class="pp-footer-back">← {back.label}</a>
          <a href="/projects/">Projects →</a>
        </footer>
      </div>
    </div>
    <script>
      // Photos fade up as they scroll into view
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll('.fx').forEach((el) => io.observe(el));

      // "See all" buttons that unfold a long list
      document.querySelectorAll<HTMLButtonElement>('.devlog-toggle').forEach((btn) => {
        const list = document.getElementById(btn.getAttribute('aria-controls') ?? '');
        if (!list) return;
        btn.addEventListener('click', () => {
          const open = list.classList.toggle('devlog--folded') === false;
          btn.setAttribute('aria-expanded', String(open));
          btn.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? '';
          if (!open) list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // Click a photo to see it full size; click again or press Esc to close
      const box = document.createElement('div');
      box.className = 'lightbox';
      box.setAttribute('role', 'dialog');
      box.setAttribute('aria-label', 'Photo, full size');
      const big = document.createElement('img');
      big.alt = '';
      box.append(big);
      document.body.append(box);
      const close = () => box.classList.remove('open');
      box.addEventListener('click', close);
      document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
      document.querySelectorAll<HTMLImageElement>('.zoomable img').forEach((img) => {
        img.addEventListener('click', () => {
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          box.classList.add('open');
        });
      });
    </script>
  </body>
</html>

<style>
  .pp-title {
    text-wrap: balance;
  }
  /* Articles read in Inter, the main site's font; the small mono labels stay as on the project pages */
  :global(.article-body .pp) {
    font-family: 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  :global(.article-body .pp-title) {
    letter-spacing: -0.035em;
  }
  :global(.article-body .entry-title) {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* Photo effects: soft shadow, fade up on scroll, a gentle zoom on hover, click to enlarge */
  :global(.fx) {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  :global(.fx.in) {
    opacity: 1;
    transform: none;
  }
  :global(.zoomable picture) {
    display: block;
    overflow: hidden;
    border-radius: 14px;
    box-shadow: 0 22px 44px -26px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--pp-line);
  }
  :global(.zoomable img) {
    display: block;
    border: 0 !important;
    border-radius: 0 !important;
    cursor: zoom-in;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.zoomable:hover img) {
    transform: scale(1.04);
  }
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(29, 27, 22, 0.82);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    cursor: zoom-out;
  }
  :global(.lightbox.open) {
    opacity: 1;
    pointer-events: auto;
  }
  :global(.lightbox img) {
    max-width: min(100%, 1200px);
    max-height: 100%;
    border-radius: 12px;
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }
  :global(.lightbox.open img) {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.fx) {
      opacity: 1;
      transform: none;
      transition: none;
    }
    :global(.zoomable img),
    :global(.lightbox img) {
      transition: none;
    }
  }
  .article-stack {
    font-size: 13px;
    max-width: 760px;
    margin-top: -4px;
  }
</style>
